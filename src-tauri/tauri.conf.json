{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turing Complete Manager",
  "version": "0.3.0",
  "identifier": "com.turingcomplete.savemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/ensure-wix.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Turing Complete Manager",
        "width": 1080,
        "height": 680,
        "minWidth": 880,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/default_characters/**",
          "**/characters/**",
          "**/originals/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "resources": {
      "./default_characters/steve/*": "default_characters/steve/",
      "./default_characters/robot/*": "default_characters/robot/",
      "../sim-shim/shim.dll": "shim.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}