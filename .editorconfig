# EditorConfig: project-level coding style baseline.
# https://editorconfig.org/
#
# Why this exists:
#   - .gitattributes normalizes line endings on `git add` (commit-time safety net).
#   - .editorconfig prevents editors from *introducing* CRLF in the first place
#     (save-time fix). Together they give us LF end-to-end even when the same
#     files are opened from Windows-native editors (VS Code, Notepad++, etc.)
#     where user-level defaults may be CRLF.
#
# `root = true` stops the lookup at this file so we don't accidentally inherit
# settings from a parent repo if this project is ever nested under one.
root = true

# Default for everything: LF, UTF-8, trim trailing whitespace, ensure final
# newline. `trim_trailing_whitespace` is intentionally NOT applied to Markdown
# (see below) because trailing double-space in Markdown is a hard line break.
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Windows batch files: cmd.exe needs CRLF to parse reliably.
[*.bat]
end_of_line = crlf

# Markdown: don't trim trailing whitespace — a line ending in two spaces is a
# valid `<br>` in CommonMark and would silently break rendered output.
[*.md]
trim_trailing_whitespace = false

# Makefiles: tabs are syntactically required for recipe indentation. Don't
# let any editor rewrite them to spaces.
[Makefile]
indent_style = tab