
def get_binary_repr(value: Int, size: Int) String {
    var text = ""
    var i = size - 1
    while i >= 0 {
        if ((value >> i) & 1) == 0 {
            text += "[F]"
        } else {
            text += "[T]"
        }
        i -= 1
    }
    return text
}

def get_input(cycle: Int) Input {

    var x = cycle
    x ^= x << 6
    x ^= x >> 5
    x ^= x << 7

    let input = Input {
        input: U8 x,
        shift: U3 (x >> 8),
    }

    ui_set_text("table[0][1]", `{input.shift}`)
    ui_set_text("table[1][1]", get_binary_repr(Int input.input, 8))

    return input

}

def check_output(cycle: Int, input: Input, output: Output) TestResult {
    let expected = Int asr(S8 input.input, S8 input.shift)
    ui_set_text("table[2][1]", get_binary_repr(expected, 8))

    if output.result_is_z {
        ui_set_text("table[3][1]", "[right][Z][Z][Z][Z][Z][Z][Z][Z][/right]")
        set_error((31337_33181499064044, `Result should never be Z state`))
        return fail
    }

    ui_set_text("table[3][1]", get_binary_repr(Int output.result, 8))

    if output.result != U8 expected & 0xff {
        return fail
    }

    if cycle == 2048 {
        return win
    }

}
