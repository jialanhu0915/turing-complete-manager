def get_binary_repr(value: Int) String {
    var text = ""
    var i = 7
    while i >= 0 {
        if ((value >> i) & 1) == 0 {
            text += "[F]"
        } else {
            text += "[T]"
        }
        i -= 1
    }
    return text
}

def get_input(cycle: Int) Input {
    var x = cycle
    x ^= x << 6
    x ^= x >> 5
    x ^= x << 7
    let input = Input {input: U8 x}

    ui_set_text("table[0][1]", `{input.input}`)
    ui_set_text("table[0][2]", get_binary_repr(Int input.input))

    let value = (~ Int input.input) & 0xff
    ui_set_text("table[1][1]", `{value}`)
    ui_set_text("table[1][2]", get_binary_repr(value))

    return input

}

def check_output(cycle: Int, input: Input, output: Output) TestResult {

    if output.output_is_z {
        return fail
    }

    ui_set_text("table[2][1]", `{output.output}`)
    ui_set_text("table[2][2]", get_binary_repr(Int output.output))

    if ~input.input != output.output {
        return fail
    }
    if cycle == 0xff {
        return win
    }
}