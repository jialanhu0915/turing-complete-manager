# sim-shim: Nim C-ABI shim source (shim.nim → sim-shim/shim.dll) + circuit/test
# fixtures (fixtures/*.data + test_si/*.si). Source is tracked; only the built
# .dll artifact stays ignored.
/sim-shim/shim.dll

# Local clones of Stuffe's tc_* repos (isa_spec, save_monger) — used
# as reference material for cross-checking our wiki calibration. Not
# vendored: kept outside version control since they're external and
# updated independently by the upstream maintainer.
/reference/

# Local vendored copy of tc_save_monger 0.4.5 (patched: decl_macro +
# macro → macro_rules! for stable Rust compat). Regenerate via:
#   cargo vendor vendor/ --manifest-path src-tauri/Cargo.toml
#   # then edit vendor/tc_save_monger/src/lib.rs (remove feature flag,
#   # convert 3 `macro X {}` to `macro_rules! X {}`)
/vendor/
